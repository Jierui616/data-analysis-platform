# 复制为 application-bigdata-local.yml（勿提交真实密钥），启动时增加 profile：
#   spring.profiles.active=dev,bigdata-local
# 或环境变量 SPRING_PROFILES_ACTIVE=dev,bigdata-local
#
# 前置：项目根目录 docker compose -f docker-compose.bigdata.yml up -d
# 首次启用后调用：POST /api/bigdata/sync/metrics（登录后）

bigdata:
  enabled: true
  clickhouse:
    enabled: true
    prefer-read: true
  kafka:
    enabled: true
    bootstrap-servers: localhost:9092
  sync:
    scheduled-enabled: false

storage:
  chartData:
    enabled: true

spring:
  kafka:
    bootstrap-servers: localhost:9092
